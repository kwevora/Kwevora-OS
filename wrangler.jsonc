{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "kwevora-os",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kwevora-os"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "kwevora_db",
      "database_name": "kwevora-db",
      "database_id": "d135a45c-4b91-40c7-932b-cb38bc629a1f"
    }
  ],
  "observability": {
    "enabled": true
  }
}
